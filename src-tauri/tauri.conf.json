{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musicplayer",
  "version": "1.0.3",
  "identifier": "com.jqx.musicplayer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Music Player",
        "dragDropEnabled": true,
        "width": 800,
        "height": 600,
        "minWidth": 700,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost",
            "assetProtocol": {
              "enable": true,
              "scope": {
                "requireLiteralLeadingDot": false,
                "allow": ["$HOME/.cache/musicplayer/artwork/**/*"]
              }
            }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "A customizable music app made for Linux",
    "longDescription": "A Music Player application optimised for desktop built natively using Tauri with JavaScript, FFmpeg and CPAL.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
